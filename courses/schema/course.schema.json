{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-platform.local/schema/course.schema.json",
  "title": "Course definition",
  "description": "Declarative course definition loaded by the course engine. Structural rules live here; step-type specific configuration is validated by the engine and the owning extension at load time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "summary", "description", "category", "difficulty", "estimated_minutes", "sections"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 120, "description": "Stable course identifier. Never change it after publishing." },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "Bump whenever the content changes. Active sessions stay on the version they started." },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1, "description": "One sentence shown in the catalog." },
    "description": { "type": "string", "minLength": 1, "description": "Markdown." },
    "category": { "type": "string", "minLength": 1 },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
    "estimated_minutes": { "type": "integer", "minimum": 1 },
    "order": { "type": "integer", "minimum": 0, "description": "Position in the course track. Lower comes first." },
    "help": { "type": "string", "description": "Coaching notes added to every step's help prompt." },
    "tags": { "type": "array", "items": { "type": "string" } },
    "objectives": { "type": "array", "items": { "type": "string" } },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "course": { "type": "string", "description": "Id of a platform course, if applicable." }
        }
      }
    },
    "glossary": {
      "type": "array",
      "description": "Key terms shown in the learner's glossary sidebar. Terms stay English in every language.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "definition"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1, "description": "Markdown." }
        }
      }
    },
    "translations": {
      "type": "object",
      "description": "Text overlays per language. Course files keep them in locales/<lang>/<course id>.yaml instead.",
      "propertyNames": { "enum": ["nl"] }
    },
    "extensions": { "type": "array", "items": { "$ref": "#/$defs/extensionId" }, "description": "Extensions the course relies on." },
    "shared_sections": {
      "type": "object",
      "description": "Step groups inlined wherever a reusable_section step references them.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["steps"],
        "properties": {
          "description": { "type": "string" },
          "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "steps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_steps": { "type": "array", "items": { "type": "string" }, "description": "Defaults to every non-optional step." }
      }
    }
  },
  "$defs": {
    "extensionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "stepType": {
      "enum": [
        "explanation", "diagram", "video", "code_example",
        "quiz", "multiple_choice", "free_text", "interactive_exercise", "diagram_exercise",
        "external_task", "mcp_connection_check", "http_endpoint_check", "git_repository_check",
        "service_check", "mcp_server_check",
        "filesystem_validation", "configuration_validation", "extension_validation",
        "conditional", "prerequisite", "project_setup", "manual_completion", "automatic_completion", "reusable_section"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
        "type": { "$ref": "#/$defs/stepType" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "body": { "type": "string", "description": "Markdown shown to the learner." },
        "extension": { "$ref": "#/$defs/extensionId", "description": "Only needed for external_task and extension_validation." },
        "config": { "type": "object", "description": "Learner-visible configuration. Extensions may redact parts of it (e.g. quiz answers)." },
        "validation": { "type": "object", "description": "Private rules evaluated server-side. Never sent to learners or agents." },
        "depends_on": { "type": "array", "items": { "type": "string" }, "description": "Omit to depend on the previous step; [] to unlock immediately." },
        "optional": { "type": "boolean" },
        "completion": { "enum": ["auto", "manual"], "description": "manual lets the learner mark the step done without validation." },
        "estimated_minutes": { "type": "integer", "minimum": 1 },
        "help": { "type": "string", "description": "Coaching notes for the help prompt the learner copies into their agent. Guide, don't solve." }
      }
    }
  }
}

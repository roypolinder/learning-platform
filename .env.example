# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection for the application role.
DATABASE_URL=postgres://learning_platform:CHANGE_ME@localhost:5432/learning_platform
DATABASE_MAX_CONNECTIONS=10

API_BIND_ADDRESS=127.0.0.1:8080
# URL agents use to reach the API/MCP server. Shown in setup instructions.
PUBLIC_BASE_URL=http://localhost:8080
COURSES_DIR=courses
# Serve the built SvelteKit app from the API (production). Leave empty in development.
WEB_DIST_DIR=
# Origin of the web app (hosts the OAuth consent page for agents). Defaults to
# PUBLIC_BASE_URL when WEB_DIST_DIR is set, otherwise to the Vite dev server.
WEB_BASE_URL=

# Hosts accepted on the MCP endpoint (DNS-rebinding protection).
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Behind a reverse proxy on the same host (Caddy, nginx): use X-Forwarded-For as the
# client address for rate limiting. Only honoured for connections from loopback.
TRUST_PROXY_HEADERS=false

# Comma-separated emails of existing accounts promoted to super admin at startup.
# Alternative: `learning-platform grant-super-admin <email>`.
SUPER_ADMIN_EMAILS=

# HTML traffic report (GoAccess) shown to super admins at /admin/traffic. Production only,
# generated by setup.sh. Leave empty in development.
TRAFFIC_REPORT_PATH=

# Account emails (verification, password reset, email change) through any SMTP provider:
#   smtps://USER:PASSWORD@smtp.example.com:465            (implicit TLS)
#   smtp://USER:PASSWORD@smtp.example.com:587?tls=required (STARTTLS)
# Leave empty in development: emails, including their links, are written to the API log.
SMTP_URL=
MAIL_FROM=Learning Platform <no-reply@localhost>

# Development conveniences. Keep false in production.
COOKIE_SECURE=false
MUTABLE_COURSE_VERSIONS=true

RUST_LOG=info,lp_api=debug,sqlx=warn,tower_http=info
